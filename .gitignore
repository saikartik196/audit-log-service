cat > .gitignore <<'EOF'
# Python virtual environment
.venv/
venv/

# Python cache
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/

# Environment variables and secrets
.env
.env.*
!.env.example

# IDE and operating system files
.vscode/
.DS_Store

# Local databases
*.db
*.sqlite
*.sqlite3

# Generated files
dist/
build/
*.egg-info/
